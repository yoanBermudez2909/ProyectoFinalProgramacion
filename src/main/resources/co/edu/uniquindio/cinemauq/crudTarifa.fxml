<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cinemauq.viewController.TarifaViewController">
    <children>
        <GridPane hgap="8.0" vgap="6.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Tipo de cliente:" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbTipoCliente" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Porcentaje del valor base:" GridPane.rowIndex="1" />
                <TextField fx:id="txtPorcentaje" promptText="Ej. 80 (entre 1 y 100)" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#onModificar" text="Modificar tarifa" />
                <Button mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
            </children>
        </HBox>
        <Label text="Valor final de la entrada = valor base de la funcion x porcentaje del tipo de cliente.">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </padding>
        </Label>
        <TableView fx:id="tblListTarifa" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tbcTipo" prefWidth="180.0" text="Tipo de cliente" />
                <TableColumn fx:id="tbcPorcentaje" prefWidth="150.0" text="Porcentaje" />
                <TableColumn fx:id="tbcEjemplo" prefWidth="240.0" text="Ejemplo con valor base $15.000" />
            </columns>
        </TableView>
    </children>
</VBox>