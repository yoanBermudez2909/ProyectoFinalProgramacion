<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cinemauq.viewController.PeliculaViewController">
    <children>
        <GridPane hgap="8.0" vgap="6.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Codigo:" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Nombre:" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Genero:" GridPane.rowIndex="2" />
                <TextField fx:id="txtGenero" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Duracion (min):" GridPane.rowIndex="3" />
                <TextField fx:id="txtDuracion" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Clasificacion:" GridPane.rowIndex="4" />
                <ComboBox fx:id="cmbClasificacion" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
                <Button mnemonicParsing="false" onAction="#onModificar" text="Modificar" />
                <Button mnemonicParsing="false" onAction="#onDeshabilitar" text="Deshabilitar" />
                <Button mnemonicParsing="false" onAction="#onHabilitar" text="Habilitar" />
                <Button mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
            </children>
        </HBox>
        <TableView fx:id="tblListPelicula" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tbcCodigo" prefWidth="80.0" text="Codigo" />
                <TableColumn fx:id="tbcNombre" prefWidth="260.0" text="Nombre" />
                <TableColumn fx:id="tbcGenero" prefWidth="140.0" text="Genero" />
                <TableColumn fx:id="tbcDuracion" prefWidth="90.0" text="Duracion" />
                <TableColumn fx:id="tbcClasificacion" prefWidth="120.0" text="Clasificacion" />
                <TableColumn fx:id="tbcEstado" prefWidth="130.0" text="Estado" />
            </columns>
        </TableView>
    </children>
</VBox>