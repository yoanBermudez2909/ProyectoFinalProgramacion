<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cinemauq.viewController.SalaViewController">
    <children>
        <GridPane hgap="8.0" vgap="6.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Codigo:" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Nombre:" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Capacidad:" GridPane.rowIndex="2" />
                <TextField fx:id="txtCapacidad" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
                <Button mnemonicParsing="false" onAction="#onModificarNombre" text="Modificar nombre" />
                <Button mnemonicParsing="false" onAction="#onDeshabilitar" text="Deshabilitar" />
                <Button mnemonicParsing="false" onAction="#onHabilitar" text="Habilitar" />
                <Button mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
            </children>
        </HBox>
        <TableView fx:id="tblListSala" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tbcCodigo" prefWidth="90.0" text="Codigo" />
                <TableColumn fx:id="tbcNombre" prefWidth="220.0" text="Nombre" />
                <TableColumn fx:id="tbcCapacidad" prefWidth="100.0" text="Capacidad" />
                <TableColumn fx:id="tbcEstado" prefWidth="150.0" text="Estado" />
            </columns>
        </TableView>
    </children>
</VBox>