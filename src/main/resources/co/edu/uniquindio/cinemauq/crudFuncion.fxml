<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.cinemauq.viewController.FuncionViewController">
    <children>
        <GridPane hgap="8.0" vgap="6.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Codigo:" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Pelicula:" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbPelicula" prefWidth="420.0" promptText="Seleccione una pelicula" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Sala:" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbSala" prefWidth="420.0" promptText="Seleccione una sala" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Fecha:" GridPane.rowIndex="3" />
                <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Hora (HH:mm):" GridPane.rowIndex="4" />
                <TextField fx:id="txtHora" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Valor base:" GridPane.rowIndex="5" />
                <TextField fx:id="txtValorBase" promptText="Ej. 15000 (sin puntos)" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#onProgramarFuncion" text="Programar funcion" />
                <Button mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
                <Button mnemonicParsing="false" onAction="#onCancelarFuncion" text="Cancelar funcion seleccionada" />
                <Button mnemonicParsing="false" onAction="#onFinalizarFuncion" text="Finalizar funcion seleccionada" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </padding>
            <children>
                <Label text="Fecha a consultar:" />
                <DatePicker fx:id="dpFechaConsulta" />
                <Button mnemonicParsing="false" onAction="#onConsultarPorFecha" text="Consultar por fecha" />
                <Button mnemonicParsing="false" onAction="#onVerTodas" text="Ver todas" />
            </children>
        </HBox>
        <TableView fx:id="tblListFuncion" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="tbcCodigo" prefWidth="70.0" text="Codigo" />
                <TableColumn fx:id="tbcPelicula" prefWidth="210.0" text="Pelicula" />
                <TableColumn fx:id="tbcSala" prefWidth="110.0" text="Sala" />
                <TableColumn fx:id="tbcFecha" prefWidth="100.0" text="Fecha" />
                <TableColumn fx:id="tbcHora" prefWidth="70.0" text="Hora" />
                <TableColumn fx:id="tbcValorBase" prefWidth="90.0" text="Valor base" />
                <TableColumn fx:id="tbcEstado" prefWidth="110.0" text="Estado" />
                <TableColumn fx:id="tbcDisponibles" prefWidth="90.0" text="Disponibles" />
            </columns>
        </TableView>
    </children>
</VBox>